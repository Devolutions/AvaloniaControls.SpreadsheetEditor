<Project Sdk="Microsoft.NET.Sdk">
    <!-- Shared settings + dependency versions come from ..\Common.props (via ..\Directory.Build.props). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SpreadsheetEditor.Controls</RootNamespace>
        <AssemblyName>SpreadsheetEditor.Controls</AssemblyName>
    </PropertyGroup>

    <!-- NuGet package metadata (shared Authors/Company/Copyright/License/URLs live in Common.props). -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Devolutions.AvaloniaControls.SpreadsheetEditor</PackageId>
        <!-- CalVer (yyyy.M.d), matching Devolutions' Avalonia package versioning. -->
        <Version>2026.7.22</Version>
        <Description>An Excel-like spreadsheet editor control for Avalonia UI: a custom grid with cell merging, rich in-cell editing, a formula engine, charts, multi-sheet tabs, undo/redo, and printing. Requires the commercial Avalonia Accelerate packages (a valid Avalonia UI license key must be supplied by the consuming application).</Description>
        <PackageTags>avalonia;spreadsheet;grid;excel;xlsx;formulas;charts;control</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Avalonia Pro (Accelerate) license key comes from the AVALONIA_LICENSE_KEY environment variable
         or a git-ignored .env at the repo root (resolved in Directory.Build.props); never committed. -->
    <ItemGroup Condition="'$(AVALONIA_LICENSE_KEY)' != ''">
        <AvaloniaUILicenseKey Include="$(AVALONIA_LICENSE_KEY)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Controls.RichTextEditor" Version="$(AvaloniaRichTextEditorVersion)" />
        <PackageReference Include="Avalonia.Controls.Charts" Version="$(AvaloniaChartsVersion)" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
        <!-- Excel (.xlsx) read/write. Ships with the package so consumers get Excel I/O out of the box. -->
        <PackageReference Include="ClosedXML" Version="$(ClosedXmlVersion)" />
    </ItemGroup>
</Project>
