<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpreadsheetEditor.Controls"
             xmlns:loc="clr-namespace:SpreadsheetEditor.Controls.Localization"
             x:Class="SpreadsheetEditor.Controls.SpreadsheetEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Chrome brushes for the toolbar/tab strip that adapt to the light/dark theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ChromeBorder" Color="#22000000" />
                    <!-- Softer than pure black so the solid vector icons don't read heavier than the
                         toolbar's text (B/I/U/S) and combo boxes. -->
                    <SolidColorBrush x:Key="IconForeground" Color="#5F6368" />
                    <SolidColorBrush x:Key="CompactButtonHover" Color="#E2E6EB" />
                    <SolidColorBrush x:Key="CompactButtonPressed" Color="#D2D9E2" />
                    <SolidColorBrush x:Key="CompactButtonFocusBorder" Color="#1A73E8" />
                    <SolidColorBrush x:Key="ToolbarCheckedBackground" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToolbarCheckedHover" Color="#006CBD" />
                    <SolidColorBrush x:Key="ToolbarCheckedPressed" Color="#005EA6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeBackground" Color="#2D2D30" />
                    <SolidColorBrush x:Key="ChromeBorder" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="IconForeground" Color="#C8CAD0" />
                    <SolidColorBrush x:Key="CompactButtonHover" Color="#3C4047" />
                    <SolidColorBrush x:Key="CompactButtonPressed" Color="#4B515B" />
                    <SolidColorBrush x:Key="CompactButtonFocusBorder" Color="#75B8FF" />
                    <SolidColorBrush x:Key="ToolbarCheckedBackground" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToolbarCheckedHover" Color="#1686DC" />
                    <SolidColorBrush x:Key="ToolbarCheckedPressed" Color="#006CBD" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ControlTheme x:Key="CompactButtonTheme" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource CompactButtonHover}" />
                </Style>
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource CompactButtonPressed}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.35" />
                </Style>
                <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BorderBrush" Value="{DynamicResource CompactButtonFocusBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </ControlTheme>
            <!-- Own both toolbar themes: hosts may replace Button while leaving ToggleButton on
                 another theme, and an icon's explicit color bypasses the host's disabled foreground. -->
            <ControlTheme x:Key="ToolbarButtonTheme" TargetType="Button" BasedOn="{StaticResource CompactButtonTheme}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
            </ControlTheme>
            <ControlTheme x:Key="ToolbarToggleButtonTheme" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarButtonTheme}">
                <Style Selector="^:checked">
                    <Setter Property="Background" Value="{DynamicResource ToolbarCheckedBackground}" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="^:checked:pointerover:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ToolbarCheckedHover}" />
                </Style>
                <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ToolbarCheckedPressed}" />
                </Style>
                <Style Selector="^:checked:disabled">
                    <Setter Property="Background" Value="{DynamicResource CompactButtonHover}" />
                    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button, ToggleButton, RepeatButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Formatting toolbar (above the editor) — grouped icon buttons styled after the
             RichTextEditor's toolbar: history · clipboard · font · color · B/I/U/S · align · overflow. -->
        <Border Grid.Row="0" Padding="4,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ChromeBorder}">
            <Border.Resources>
                <!-- Vector toolbar icons (24x24 paths) so they render on every OS — the previous
                     Segoe icon font is Windows-only and showed blank on Linux/macOS. -->
                <StreamGeometry x:Key="IconUndo">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z</StreamGeometry>
                <StreamGeometry x:Key="IconRedo">M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z</StreamGeometry>
                <StreamGeometry x:Key="IconCut">M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3z</StreamGeometry>
                <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
                <StreamGeometry x:Key="IconPaste">M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z</StreamGeometry>
                <StreamGeometry x:Key="IconPrint">M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z</StreamGeometry>
                <StreamGeometry x:Key="IconFillColor">M8 1L6.6 2.4L8.7 4.5L3.5 9.7C2.8 10.4 2.8 11.6 3.5 12.3L9.2 18C9.9 18.7 11.1 18.7 11.8 18L18.7 11.1L10 2.4L8 1ZM5.5 10.5L10.1 5.9L14.7 10.5H5.5ZM20 12.5C20 12.5 17.5 15.4 17.5 17.2A2.5 2.5 0 0 0 22.5 17.2C22.5 15.4 20 12.5 20 12.5Z</StreamGeometry>
                <StreamGeometry x:Key="IconAlignLeft">M15 15H3v2h12v-2zm0-8H3v2h12V7zM3 13h18v-2H3v2zm0 8h18v-2H3v2zM3 3v2h18V3H3z</StreamGeometry>
                <StreamGeometry x:Key="IconAlignCenter">M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6v2h10V7H7zM3 3v2h18V3H3z</StreamGeometry>
                <StreamGeometry x:Key="IconAlignRight">M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z</StreamGeometry>
                <StreamGeometry x:Key="IconMore">M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
            </Border.Resources>
            <Border.Styles>
                <!-- Compact, flat, square icon buttons across the whole toolbar. -->
                <Style Selector="Button.tool, ToggleButton.tool">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Button.tool">
                    <Setter Property="Theme" Value="{StaticResource ToolbarButtonTheme}" />
                </Style>
                <Style Selector="ToggleButton.tool">
                    <Setter Property="Theme" Value="{StaticResource ToolbarToggleButtonTheme}" />
                </Style>
                <!-- Vector toolbar icons use a slightly lighter shade for visual weight consistency. -->
                <Style Selector="PathIcon">
                    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
                <Style Selector="Border.divider">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource ChromeBorder}" />
                    <Setter Property="Margin" Value="3,2" />
                </Style>
            </Border.Styles>
            <StackPanel Orientation="Horizontal" Spacing="1">

                <!-- History -->
                <Button x:Name="UndoButton" Classes="tool" ToolTip.Tip="{loc:Loc Undo}">
                    <PathIcon Data="{StaticResource IconUndo}" Width="16" Height="16" />
                </Button>
                <Button x:Name="RedoButton" Classes="tool" ToolTip.Tip="{loc:Loc Redo}">
                    <PathIcon Data="{StaticResource IconRedo}" Width="16" Height="16" />
                </Button>

                <Border Classes="divider" />

                <!-- Clipboard -->
                <Button x:Name="CutButton" Classes="tool" ToolTip.Tip="{loc:Loc Cut}">
                    <PathIcon Data="{StaticResource IconCut}" Width="16" Height="16" />
                </Button>
                <Button x:Name="CopyButton" Classes="tool" ToolTip.Tip="{loc:Loc Copy}">
                    <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" />
                </Button>
                <Button x:Name="PasteButton" Classes="tool" ToolTip.Tip="{loc:Loc Paste}">
                    <PathIcon Data="{StaticResource IconPaste}" Width="16" Height="16" />
                </Button>

                <Border Classes="divider" />

                <!-- Print -->
                <Button x:Name="PrintButton" Classes="tool" ToolTip.Tip="{loc:Loc Print}">
                    <PathIcon Data="{StaticResource IconPrint}" Width="16" Height="16" />
                </Button>

                <Border Classes="divider" />

                <!-- Font -->
                <ComboBox x:Name="FontFamilyBox" Width="140" Height="28" Focusable="False" ToolTip.Tip="{loc:Loc Font}" />
                <ComboBox x:Name="FontSizeBox" Width="60" Height="28" Focusable="False" ToolTip.Tip="{loc:Loc FontSize}" />

                <Border Classes="divider" />

                <!-- Color / highlight -->
                <Button x:Name="ForegroundButton" Classes="tool" ToolTip.Tip="{loc:Loc TextColor}">
                    <Button.Content>
                        <StackPanel Orientation="Vertical" Spacing="0" HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc TextColorGlyph}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <Border x:Name="ForegroundSwatch" Width="16" Height="3" Background="Black" />
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="6">
                                <Button x:Name="AutomaticTextColorButton"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Focusable="False" AutomationProperties.Name="{loc:Loc Automatic}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="AutomaticTextColorSwatch" Width="16" Height="16" Background="Black" BorderBrush="Gray" BorderThickness="1" />
                                        <TextBlock Text="{loc:Loc Automatic}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Separator />
                                <WrapPanel x:Name="ForegroundPalette" Width="132" />
                                <Separator />
                                <Button x:Name="MoreTextColorsButton" Content="{loc:Loc MoreColors}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="False" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="BackgroundButton" Classes="tool" ToolTip.Tip="{loc:Loc FillColor}" AutomationProperties.Name="{loc:Loc FillColor}">
                    <Button.Content>
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFillColor}" Width="16" Height="16" />
                            <Border x:Name="BackgroundSwatch" Width="16" Height="3" Background="Yellow"
                                    BorderBrush="{Binding $parent[Button].Foreground}" BorderThickness="0.5" />
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="6">
                                <WrapPanel x:Name="BackgroundPalette" Width="132" />
                                <Separator />
                                <Button x:Name="MoreFillColorsButton" Content="{loc:Loc MoreColors}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="False" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Border Classes="divider" />

                <!-- Character formatting -->
                <ToggleButton x:Name="BoldButton" Classes="tool" ToolTip.Tip="{loc:Loc Bold}">
                    <TextBlock Text="{loc:Loc BoldGlyph}" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Classes="tool" ToolTip.Tip="{loc:Loc Italic}" AutomationProperties.Name="{loc:Loc Italic}">
                    <PathIcon Data="M4.5 0H9V1H7.2L3.4 10H4.5V11H0V10H1.8L5.6 1H4.5Z" Width="9" Height="11" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Classes="tool" ToolTip.Tip="{loc:Loc Underline}">
                    <TextBlock Text="{loc:Loc UnderlineGlyph}" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton x:Name="StrikethroughButton" Classes="tool" ToolTip.Tip="{loc:Loc Strikethrough}">
                    <TextBlock Text="{loc:Loc StrikethroughGlyph}" TextDecorations="Strikethrough" />
                </ToggleButton>

                <Border Classes="divider" />

                <!-- Alignment -->
                <ToggleButton x:Name="AlignLeftButton" Classes="tool" ToolTip.Tip="{loc:Loc AlignLeft}">
                    <PathIcon Data="{StaticResource IconAlignLeft}" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton x:Name="AlignCenterButton" Classes="tool" ToolTip.Tip="{loc:Loc AlignCenter}">
                    <PathIcon Data="{StaticResource IconAlignCenter}" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton x:Name="AlignRightButton" Classes="tool" ToolTip.Tip="{loc:Loc AlignRight}">
                    <PathIcon Data="{StaticResource IconAlignRight}" Width="16" Height="16" />
                </ToggleButton>

                <Border Classes="divider" />

                <Button x:Name="MergeCellsButton" Classes="tool" ToolTip.Tip="{loc:Loc MergeCells}" AutomationProperties.Name="{loc:Loc MergeCells}">
                    <PathIcon Data="M3 3H9V5H5V9H3ZM15 3H21V9H19V5H15ZM3 15H5V19H9V21H3ZM19 15H21V21H15V19H19ZM4 11H9V8L13 12L9 16V13H4ZM20 11V13H15V16L11 12L15 8V11Z" Width="18" Height="18" />
                </Button>
                <Button x:Name="BordersButton" Classes="tool" ToolTip.Tip="{loc:Loc Borders}" AutomationProperties.Name="{loc:Loc Borders}">
                    <PathIcon Data="M3 3H21V21H3ZM5 5V11H11V5ZM13 5V11H19V5ZM5 13V19H11V13ZM13 13V19H19V13Z" Width="18" Height="18" />
                </Button>

                <!-- Insert symbol (currency &amp; math). Flyout built in code-behind. -->
                <Button x:Name="SymbolButton" Classes="tool" Content="&#x3A9;" FontSize="15" ToolTip.Tip="{loc:Loc InsertSymbol}" />

                <Border Classes="divider" />

                <!-- Overflow: spreadsheet-specific actions (built in code-behind). -->
                <Button x:Name="OverflowButton" Classes="tool" ToolTip.Tip="{loc:Loc MoreActions}">
                    <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Formula / cell editor bar -->
        <Grid Grid.Row="1" ColumnDefinitions="90,Auto,*" Margin="4" ColumnSpacing="6">
            <TextBox x:Name="NameBox" Grid.Column="0" IsReadOnly="True"
                     VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{loc:Loc FormulaGlyph}" FontStyle="Italic"
                       VerticalAlignment="Center" Opacity="0.7" />
            <Border x:Name="EditorHost" Grid.Column="2" MinHeight="30" />
        </Grid>

        <!-- Find and replace stays inside the editor so Ctrl+F is handled here instead of bubbling to
             the host application's global search. -->
        <Border x:Name="FindReplaceBar" Grid.Row="2" IsVisible="False" Padding="6,4"
                BorderThickness="0,1,0,1" BorderBrush="{DynamicResource ChromeBorder}"
                Background="{DynamicResource ChromeBackground}">
            <Grid ColumnDefinitions="Auto,180,Auto,Auto,Auto,180,Auto,Auto,*,Auto" ColumnSpacing="5">
                <TextBlock Grid.Column="0" Text="{loc:Loc Find}" VerticalAlignment="Center" />
                <TextBox x:Name="FindTextBox" Grid.Column="1" MinWidth="120" VerticalContentAlignment="Center" />
                <Button x:Name="FindPreviousButton" Grid.Column="2" Content="{loc:Loc Previous}" Padding="8,3" />
                <Button x:Name="FindNextButton" Grid.Column="3" Content="{loc:Loc Next}" Padding="8,3" />
                <TextBlock Grid.Column="4" Text="{loc:Loc ReplaceWith}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBox x:Name="ReplaceTextBox" Grid.Column="5" MinWidth="120" VerticalContentAlignment="Center" />
                <Button x:Name="ReplaceButton" Grid.Column="6" Content="{loc:Loc Replace}" Padding="8,3" />
                <Button x:Name="ReplaceAllButton" Grid.Column="7" Content="{loc:Loc ReplaceAll}" Padding="8,3" />
                <TextBlock x:Name="FindStatusText" Grid.Column="8" Margin="8,0" VerticalAlignment="Center" Opacity="0.75" />
                <Button x:Name="CloseFindButton" Grid.Column="9" Theme="{StaticResource CompactButtonTheme}" Width="28" Height="28" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Loc CloseFindReplace}" AutomationProperties.Name="{loc:Loc CloseFindReplace}">
                    <PathIcon Data="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4Z"
                              Width="12" Height="12" Foreground="{DynamicResource IconForeground}" IsHitTestVisible="False" />
                </Button>
            </Grid>
        </Border>

        <!-- License/fallback notice (hidden when the Pro RichTextEditor activates) -->
        <Border x:Name="LicenseWarning" Grid.Row="3" IsVisible="False"
                Background="#33B00020" Padding="8,4" Margin="4,0,4,4">
            <TextBlock x:Name="LicenseWarningText" TextWrapping="Wrap" Foreground="#B00020" />
        </Border>

        <!-- The spreadsheet grid: a custom control (not the Avalonia DataGrid) so cells can span
             (merge) and host rich content — which the DataGrid can't do. Renders from the
             SpreadsheetViewModel; click-to-select drives the active cell. -->
        <local:SpreadsheetGrid x:Name="Grid" Grid.Row="4" />

        <!-- Shown while a workbook or worksheet is prepared without blocking the window. -->
        <Border x:Name="LoadingOverlay" Grid.Row="4" IsVisible="False"
                Background="{DynamicResource ChromeBackground}" Opacity="0.96">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="240">
                <TextBlock Text="{loc:Loc Loading}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" Height="4" />
            </StackPanel>
        </Border>

        <!-- Sheet tabs (Excel-style) + add-sheet button, with a zoom control docked right. -->
        <Border x:Name="SheetBar" Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ChromeBorder}" Background="{DynamicResource ChromeBackground}" Padding="4,3">
            <Border.Resources>
                <StreamGeometry x:Key="SheetChevronLeft">M14.7 5.3 8 12 14.7 18.7 16.1 17.3 10.8 12 16.1 6.7Z</StreamGeometry>
                <StreamGeometry x:Key="SheetChevronRight">M9.3 5.3 16 12 9.3 18.7 7.9 17.3 13.2 12 7.9 6.7Z</StreamGeometry>
                <StreamGeometry x:Key="SheetPlus">M11 5H13V11H19V13H13V19H11V13H5V11H11Z</StreamGeometry>
                <StreamGeometry x:Key="SheetMinus">M5 11H19V13H5Z</StreamGeometry>
            </Border.Resources>
            <Border.Styles>
                <Style Selector="PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
            </Border.Styles>
            <DockPanel LastChildFill="True">
                <!-- Zoom control (Excel-style): − · 100% · + -->
                <Border DockPanel.Dock="Right" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ChromeBorder}" Padding="8,0,0,0" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="ZoomOutButton" Theme="{StaticResource CompactButtonTheme}" ToolTip.Tip="{loc:Loc ZoomOut}" AutomationProperties.Name="{loc:Loc ZoomOut}">
                            <PathIcon Data="{StaticResource SheetMinus}" Width="12" Height="12" />
                        </Button>
                        <Button x:Name="ZoomResetButton" Theme="{StaticResource CompactButtonTheme}" Content="100%" Width="48" FontSize="12"
                                ToolTip.Tip="{loc:Loc ResetZoom}" AutomationProperties.Name="{loc:Loc ResetZoom}" />
                        <Button x:Name="ZoomInButton" Theme="{StaticResource CompactButtonTheme}" ToolTip.Tip="{loc:Loc ZoomIn}" AutomationProperties.Name="{loc:Loc ZoomIn}">
                            <PathIcon Data="{StaticResource SheetPlus}" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <RepeatButton x:Name="ScrollSheetTabsLeftButton" Theme="{StaticResource CompactButtonTheme}" IsEnabled="False" Delay="350" Interval="70"
                                      ToolTip.Tip="{loc:Loc ScrollSheetTabsLeft}" AutomationProperties.Name="{loc:Loc ScrollSheetTabsLeft}">
                            <PathIcon Data="{StaticResource SheetChevronLeft}" Width="12" Height="12" />
                        </RepeatButton>
                        <RepeatButton x:Name="ScrollSheetTabsRightButton" Theme="{StaticResource CompactButtonTheme}" IsEnabled="False" Delay="350" Interval="70"
                                      ToolTip.Tip="{loc:Loc ScrollSheetTabsRight}" AutomationProperties.Name="{loc:Loc ScrollSheetTabsRight}">
                            <PathIcon Data="{StaticResource SheetChevronRight}" Width="12" Height="12" />
                        </RepeatButton>
                    </StackPanel>
                    <Button x:Name="AddSheetButton" Grid.Column="1" Theme="{StaticResource CompactButtonTheme}" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Loc AddSheet}" AutomationProperties.Name="{loc:Loc AddSheet}">
                        <PathIcon Data="{StaticResource SheetPlus}" Width="14" Height="14" />
                    </Button>
                    <ScrollViewer x:Name="SheetTabScroller" Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SheetTabs" Orientation="Horizontal" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
