<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpreadsheetEditor.Controls"
             x:Class="SpreadsheetEditor.Controls.SpreadsheetEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Chrome brushes for the toolbar/tab strip that adapt to the light/dark theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ChromeBorder" Color="#22000000" />
                    <!-- Softer than pure black so the solid vector icons don't read heavier than the
                         toolbar's text (B/I/U/S) and combo boxes. -->
                    <SolidColorBrush x:Key="IconForeground" Color="#5F6368" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeBackground" Color="#2D2D30" />
                    <SolidColorBrush x:Key="ChromeBorder" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="IconForeground" Color="#C8CAD0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Formatting toolbar (above the editor) — grouped icon buttons styled after the
             RichTextEditor's toolbar: history · clipboard · font · color · B/I/U/S · align · overflow. -->
        <Border Grid.Row="0" Padding="4,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ChromeBorder}">
            <Border.Resources>
                <!-- Vector toolbar icons (24x24 paths) so they render on every OS — the previous
                     Segoe icon font is Windows-only and showed blank on Linux/macOS. -->
                <StreamGeometry x:Key="IconUndo">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z</StreamGeometry>
                <StreamGeometry x:Key="IconRedo">M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z</StreamGeometry>
                <StreamGeometry x:Key="IconCut">M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3z</StreamGeometry>
                <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
                <StreamGeometry x:Key="IconPaste">M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z</StreamGeometry>
                <StreamGeometry x:Key="IconPrint">M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z</StreamGeometry>
                <StreamGeometry x:Key="IconAlignLeft">M15 15H3v2h12v-2zm0-8H3v2h12V7zM3 13h18v-2H3v2zm0 8h18v-2H3v2zM3 3v2h18V3H3z</StreamGeometry>
                <StreamGeometry x:Key="IconAlignCenter">M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6v2h10V7H7zM3 3v2h18V3H3z</StreamGeometry>
                <StreamGeometry x:Key="IconAlignRight">M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z</StreamGeometry>
                <StreamGeometry x:Key="IconMore">M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
            </Border.Resources>
            <Border.Styles>
                <!-- Compact, flat, square icon buttons across the whole toolbar. -->
                <Style Selector="Button.tool, ToggleButton.tool">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <!-- Vector toolbar icons use a slightly lighter shade for visual weight consistency. -->
                <Style Selector="PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
                </Style>
                <Style Selector="Border.divider">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource ChromeBorder}" />
                    <Setter Property="Margin" Value="3,2" />
                </Style>
            </Border.Styles>
            <StackPanel Orientation="Horizontal" Spacing="1">

                <!-- History -->
                <Button x:Name="UndoButton" Classes="tool" ToolTip.Tip="Undo">
                    <PathIcon Data="{StaticResource IconUndo}" Width="16" Height="16" />
                </Button>
                <Button x:Name="RedoButton" Classes="tool" ToolTip.Tip="Redo">
                    <PathIcon Data="{StaticResource IconRedo}" Width="16" Height="16" />
                </Button>

                <Border Classes="divider" />

                <!-- Clipboard -->
                <Button x:Name="CutButton" Classes="tool" ToolTip.Tip="Cut">
                    <PathIcon Data="{StaticResource IconCut}" Width="16" Height="16" />
                </Button>
                <Button x:Name="CopyButton" Classes="tool" ToolTip.Tip="Copy">
                    <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" />
                </Button>
                <Button x:Name="PasteButton" Classes="tool" ToolTip.Tip="Paste">
                    <PathIcon Data="{StaticResource IconPaste}" Width="16" Height="16" />
                </Button>

                <Border Classes="divider" />

                <!-- Print -->
                <Button x:Name="PrintButton" Classes="tool" ToolTip.Tip="Print">
                    <PathIcon Data="{StaticResource IconPrint}" Width="16" Height="16" />
                </Button>

                <Border Classes="divider" />

                <!-- Font -->
                <ComboBox x:Name="FontFamilyBox" Width="140" Height="28" Focusable="False" ToolTip.Tip="Font" />
                <ComboBox x:Name="FontSizeBox" Width="60" Height="28" Focusable="False" ToolTip.Tip="Font size" />

                <Border Classes="divider" />

                <!-- Color / highlight -->
                <Button x:Name="ForegroundButton" Classes="tool" ToolTip.Tip="Text color">
                    <Button.Content>
                        <StackPanel Orientation="Vertical" Spacing="0" HorizontalAlignment="Center">
                            <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" />
                            <Border x:Name="ForegroundSwatch" Width="16" Height="3" Background="Black" />
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout>
                            <WrapPanel x:Name="ForegroundPalette" Width="132" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="BackgroundButton" Classes="tool" ToolTip.Tip="Highlight / fill color">
                    <Button.Content>
                        <Border BorderBrush="#66000000" BorderThickness="1" CornerRadius="2" Width="18" Height="14">
                            <Border x:Name="BackgroundSwatch" Background="Yellow" Margin="1" CornerRadius="1" />
                        </Border>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout>
                            <WrapPanel x:Name="BackgroundPalette" Width="132" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Border Classes="divider" />

                <!-- Character formatting -->
                <ToggleButton x:Name="BoldButton" Classes="tool" ToolTip.Tip="Bold">
                    <TextBlock Text="B" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Classes="tool" ToolTip.Tip="Italic">
                    <TextBlock Text="I" FontStyle="Italic" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Classes="tool" ToolTip.Tip="Underline">
                    <TextBlock Text="U" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton x:Name="StrikethroughButton" Classes="tool" ToolTip.Tip="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                </ToggleButton>

                <Border Classes="divider" />

                <!-- Alignment -->
                <ToggleButton x:Name="AlignLeftButton" Classes="tool" ToolTip.Tip="Align left">
                    <PathIcon Data="{StaticResource IconAlignLeft}" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton x:Name="AlignCenterButton" Classes="tool" ToolTip.Tip="Align center">
                    <PathIcon Data="{StaticResource IconAlignCenter}" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton x:Name="AlignRightButton" Classes="tool" ToolTip.Tip="Align right">
                    <PathIcon Data="{StaticResource IconAlignRight}" Width="16" Height="16" />
                </ToggleButton>

                <Border Classes="divider" />

                <!-- Insert symbol (currency &amp; math). Flyout built in code-behind. -->
                <Button x:Name="SymbolButton" Classes="tool" Content="&#x3A9;" FontSize="15" ToolTip.Tip="Insert symbol (currency &amp; math)" />

                <Border Classes="divider" />

                <!-- Overflow: spreadsheet-specific actions (built in code-behind). -->
                <Button x:Name="OverflowButton" Classes="tool" ToolTip.Tip="More (formulas, chart, rows/columns)">
                    <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Formula / cell editor bar -->
        <Grid Grid.Row="1" ColumnDefinitions="90,Auto,*" Margin="4" ColumnSpacing="6">
            <TextBox x:Name="NameBox" Grid.Column="0" IsReadOnly="True"
                     VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="1" Text="fx" FontStyle="Italic"
                       VerticalAlignment="Center" Opacity="0.7" />
            <Border x:Name="EditorHost" Grid.Column="2" MinHeight="30"
                    BorderThickness="1" BorderBrush="{DynamicResource ChromeBorder}" CornerRadius="3" />
        </Grid>

        <!-- License/fallback notice (hidden when the Pro RichTextEditor activates) -->
        <Border x:Name="LicenseWarning" Grid.Row="2" IsVisible="False"
                Background="#33B00020" Padding="8,4" Margin="4,0,4,4">
            <TextBlock x:Name="LicenseWarningText" TextWrapping="Wrap" Foreground="#B00020" />
        </Border>

        <!-- The spreadsheet grid: a custom control (not the Avalonia DataGrid) so cells can span
             (merge) and host rich content — which the DataGrid can't do. Renders from the
             SpreadsheetViewModel; click-to-select drives the active cell. -->
        <local:SpreadsheetGrid x:Name="Grid" Grid.Row="3" />

        <!-- Sheet tabs (Excel-style) + add-sheet button, with a zoom control docked right. -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ChromeBorder}" Background="{DynamicResource ChromeBackground}" Padding="4,2">
            <DockPanel LastChildFill="True">
                <!-- Zoom control (Excel-style): − · 100% · + -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="6,0,2,0">
                    <Button x:Name="ZoomOutButton" Content="−" Width="24" Height="22" Padding="0" Focusable="False" ToolTip.Tip="Zoom out (Ctrl+-)" />
                    <Button x:Name="ZoomResetButton" Content="100%" Width="52" Height="22" Padding="0" Focusable="False" ToolTip.Tip="Reset zoom to 100% (Ctrl+0)" />
                    <Button x:Name="ZoomInButton" Content="+" Width="24" Height="22" Padding="0" Focusable="False" ToolTip.Tip="Zoom in (Ctrl++)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="AddSheetButton" Content="+" Width="26" Focusable="False"
                            ToolTip.Tip="Add sheet" Padding="0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SheetTabs" Orientation="Horizontal" Spacing="2" />
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
